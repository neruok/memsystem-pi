MEMSYSTEM_DATABASE_URL=postgresql://memsystem_service:memsystem@127.0.0.1:5432/memsystem
MEMSYSTEM_API_TOKEN=replace-with-a-random-secret
MEMSYSTEM_API_TOKEN_USER_ID=00000000-0000-0000-0000-000000000000
MEMSYSTEM_API_TOKEN_EXPIRES_AT=0
MEMSYSTEM_CONTEXT_TOKEN_KEY=replace-with-a-separate-random-secret
MEMSYSTEM_CONTEXT_TOKEN_TTL=300
MEMSYSTEM_ISSUER_URL=http://127.0.0.1:8000
MEMSYSTEM_RESOURCE_URL=http://127.0.0.1:8000/mcp
MEMSYSTEM_VECTOR_RECALL=false
# Optional positive cap. Unset to allow the complete authorized vector set.
MEMSYSTEM_VECTOR_ALLOWLIST_LIMIT=
MEMSYSTEM_EMBEDDING_DEVICE=auto
MEMSYSTEM_EMBEDDING_CACHE_DIR=~/.cache/memsystem/transformers
